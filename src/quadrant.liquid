{% capture moon_svg2 %}<svg width="34" height="34" viewBox="0 0 48 48"><circle cx="24" cy="24" r="22" fill="#000"/><path d="M24 2 A22 22 0 0 {{ s1 }} 24 46 A{{ mrx }} 22 0 0 {{ s2 }} 24 2 Z" fill="#fff"/><circle cx="24" cy="24" r="22" fill="none" stroke="#000" stroke-width="2.5"/></svg>{% endcapture %}
<style>
.al{flex:1 0 auto;height:100%;min-height:164px;width:100%;overflow:hidden;display:flex;flex-direction:column;box-sizing:border-box;border:4px double #000;padding:2px 6px 0;font-family:Georgia,'Times New Roman','Liberation Serif','DejaVu Serif',serif;color:#000}
.al *{box-sizing:border-box}
.al-mast{text-align:center;border-bottom:2px solid #000;font-weight:700;text-transform:uppercase;letter-spacing:4px;padding-bottom:1px;font-size:16px}
.al-top{display:flex;gap:8px;margin-top:3px}
.al-top>div{flex:1}
.al-big{font-size:58px;font-weight:700;line-height:.95;text-align:center;letter-spacing:-1px}
.al-cap{text-align:center;font-style:italic;font-size:12px}
.al-note{margin:2px 0;text-align:center;background:#000;color:#fff;font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;padding:1px 0}
.al-calm{background:#fff;color:#000;border:1px solid #000}
.al-moonrow{display:flex;align-items:center;gap:7px;margin:3px 0}
.al-moonrow div{font-weight:700;line-height:1.1;font-size:13px}
.al-moonrow i{display:block;font-weight:400;font-size:12px}
.al-pl{border-top:1px solid #000;padding-top:2px}
.al-pl b{font-size:14px;display:block;line-height:1.1}.al-pl span{font-size:12px;font-style:italic}
@media (min-width:500px){.al{zoom:1.3}.al-big{font-size:68px}}
</style>
<div class="layout layout--col">
<div class="al">
 <div class="al-mast">Almanac</div>
 <div class="al-top"><div style="border-right:1px solid #000;padding-right:6px"><div class="al-big">{{ hero_n }}</div><div class="al-cap">days to {{ hero_label | downcase }}<br>{{ hero_date }}</div></div>
 <div>{% if frost_alert != "" %}<div class="al-note">{{ frost_alert }}</div>{% else %}<div class="al-note al-calm">{{ frost_state }}</div>{% endif %}
 <div class="al-moonrow">{{ moon_svg2 }}<div>{{ msign }}{% unless r_root == 'A' %}<i>Root: {% if r_root == 'F' %}Best{% else %}Fair{% endif %}</i>{% endunless %}</div></div>
 {% assign c = 0 %}{% for e in ev.events %}{% if e.f == 1 %}{% assign anchor = ff %}{% else %}{% assign anchor = lf %}{% endif %}{% assign d = e.w | times: 7 | plus: anchor | minus: today %}{% if d < -14 %}{% assign d = d | plus: 365 %}{% endif %}{% if d >= -14 and d <= 6 and c < 1 %}{% assign c = c | plus: 1 %}<div class="al-pl"><b>{{ e.n }}</b><span>{% case e.a %}{% when 's' %}Start indoors{% when 't' %}Transplant{% when 'd' %}Direct sow{% else %}Plan{% endcase %}{% if e.dp %}, {{ e.dp }} in deep{% endif %}</span></div>{% endif %}{% endfor %}
 {% if now_n == 0 %}<div class="al-pl"><b>Relax, there is nothing to plant today.</b></div>{% endif %}</div></div>
</div>
</div>
<div class="title_bar"><span class="title">Almanac</span></div>
