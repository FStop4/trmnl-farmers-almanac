{% assign sdays = ff | minus: lf %}
{% if sdays < 1 %}{% assign pct = 0 %}{% assign season_txt = "" %}{% elsif today >= ff %}{% assign pct = 100 %}{% assign season_txt = "Season ended " | append: ffd %}{% elsif today < lf %}{% assign pct = 0 %}{% assign season_txt = "Opens " | append: lfd %}{% else %}{% assign sd = today | minus: lf %}{% assign pct = sd | times: 100 | divided_by: sdays %}{% assign season_txt = "Day " | append: sd | append: " of " | append: sdays %}{% endif %}
{% assign dfull = 14.7653 | minus: mage %}{% if dfull < 0 %}{% assign dfull = dfull | plus: 29.530588 %}{% endif %}
{% assign dnew = 29.530588 | minus: mage %}
{% assign nf_s = dfull | times: 86400 | round | plus: ts %}{% assign nw_s = dnew | times: 86400 | round | plus: ts %}
{% assign chores = "Order seeds, sharpen tools, plan the beds.|Prune fruit trees; start slow seedlings indoors.|Sow peas and spinach once soil can be worked.|Harden off seedlings; set out cool-season crops.|Plant warm-season crops after the last frost.|Mulch beds, stake tomatoes, water deeply.|Water deeply in the morning; harvest often.|Sow fall crops and watch for pests.|Plant fall greens; save seed from your best plants.|Plant garlic; rake leaves into the compost.|Mulch garlic and greens with 3 in of straw.|Clean and oil tools; protect tender plants." | split: "|" %}
{% assign mi = ts | date: "%-m" | minus: 1 %}{% assign chore = chores[mi] %}
{% capture moon_svg2 %}<svg width="52" height="52" viewBox="0 0 48 48"><clipPath id="lit"><path d="M24 2 A22 22 0 0 {{ s1 }} 24 46 A{{ mrx }} 22 0 0 {{ s2 }} 24 2 Z"/></clipPath><circle cx="24" cy="24" r="22" fill="#000"/><path d="M24 2 A22 22 0 0 {{ s1 }} 24 46 A{{ mrx }} 22 0 0 {{ s2 }} 24 2 Z" fill="#fff"/><g clip-path="url(#lit)" fill="none" stroke="#000" stroke-width="1.2"><circle cx="30" cy="14" r="3.5"/><circle cx="35" cy="26" r="4.5"/><circle cx="27" cy="36" r="3"/><circle cx="20" cy="22" r="2"/><circle cx="38" cy="36" r="2"/><circle cx="14" cy="34" r="2.5"/></g><circle cx="24" cy="24" r="22" fill="none" stroke="#000" stroke-width="2.5"/></svg>{% endcapture %}
<style>
.al{flex:1 0 auto;height:100%;min-height:404px;width:100%;overflow:hidden;display:flex;flex-direction:column;box-sizing:border-box;border:4px double #000;padding:2px 6px 0;font-family:Georgia,'Times New Roman','Liberation Serif','DejaVu Serif',serif;color:#000}
.al *{box-sizing:border-box}
.al-mast{text-align:center;border-bottom:2px solid #000;padding:2px 0 3px}
.al-mast h1{margin:0;font-size:31px;line-height:1.05;letter-spacing:6px;font-weight:700;text-transform:uppercase}
.al-mast p{margin:1px 0 0;font-size:16px;font-style:italic}
.al-anno{font-size:12px;letter-spacing:2px;text-transform:uppercase}
.al-body{display:flex;flex:1;min-height:0;border-bottom:2px solid #000}
.al-col{display:flex;flex-direction:column;flex:1;padding:6px 10px 4px;border-right:1px solid #000;min-width:0}
.al-col:last-child{border-right:none}
.al-hd{font-size:14px;letter-spacing:3px;text-transform:uppercase;font-weight:700;text-align:center;border-bottom:1px solid #000;margin:0 0 5px;padding-bottom:2px}
.al-big{font-size:84px;font-weight:700;line-height:.95;text-align:center;letter-spacing:-2px}
.al-cap{text-align:center;font-size:17px;font-style:italic;margin-top:2px;margin-bottom:8px}
.al-cap b{font-style:normal}
.al-note{margin:6px 0 3px;text-align:center;background:#000;color:#fff;font-weight:700;font-size:17px;letter-spacing:2px;text-transform:uppercase;padding:2px 0}
.al-calm{background:#fff;color:#000;border:1px solid #000}
.al-sm{text-align:center;font-size:15px}
.al-bar{margin:auto 0 0;padding-top:6px}
.al-bar small{display:block;font-size:12px;letter-spacing:1px;text-transform:uppercase;font-weight:700;text-align:center}
.al-track{height:11px;border:1px solid #000;margin:2px 0}
.al-fill{height:100%;background:#000}
.al-bar em{display:block;font-size:13px;text-align:center}
.al-moonrow{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:5px}
.al-moonrow svg{flex:none}
.al-moonrow div{font-size:19px;font-weight:700;line-height:1.1}
.al-moonrow i{display:block;font-size:15px;font-weight:400}
.al-row{display:flex;align-items:baseline;font-size:18px;margin:4px 0}
.al-dots{flex:1;border-bottom:2px dotted #000;margin:0 5px;transform:translateY(-3px)}
.al-rt{font-weight:700;font-size:16px;letter-spacing:1px;text-transform:uppercase;padding:0 6px}
.al-best{background:#000;color:#fff}
.al-fair{border:1px solid #000}
.al-nm{font-size:14px;text-align:center;margin-top:auto;padding-top:5px;line-height:1.25}
.al-foot{font-size:13px;font-style:italic;text-align:center;margin-top:5px}
.al-item{margin:0 0 5px}
.al-item b{font-size:20px;display:block;line-height:1.1}
.al-item span{font-size:15px;font-style:italic}
.al-sub{font-size:13px;letter-spacing:2px;text-transform:uppercase;font-weight:700;border-top:1px solid #000;margin:6px 0 3px;padding-top:3px}
.al-up{display:flex;align-items:baseline;font-size:16px;margin:2px 0}
.al-chore{font-size:14px;font-style:italic;line-height:1.2}
.al-wis{text-align:center;padding:4px 20px 3px;font-size:17px;font-style:italic;line-height:1.2}
.al-wis small{display:block;font-size:12px;letter-spacing:2px;text-transform:uppercase;font-style:normal}
.al-x{display:none}
@media (min-width:1000px){.al{zoom:1.3}.al-item.al-x{display:block}.al-up.al-x{display:flex}.al-big{font-size:112px}.al-row{margin:9px 0}.al-item{margin-bottom:9px}.al-moonrow svg{width:70px;height:70px}.al-note{margin:12px 0 6px}}
</style>
<div class="layout layout--col">
<div class="al">
 <div class="al-mast"><h1>The Garden Almanac</h1><p>{{ ts | date: "%A, %B %-d" }} &middot; {{ place }}</p><div class="al-anno">Anno {{ yr }} &middot; Day {{ today }}</div></div>
 <div class="al-body">
  <div class="al-col"><div class="al-hd">Frost Reckoning</div>
   <div class="al-big">{{ hero_n }}</div><div class="al-cap">days to {{ hero_label | downcase }} &middot; <b>{{ hero_date }}</b></div>
   {% if frost_alert != "" %}<div class="al-note">{{ frost_alert }}</div>{% else %}<div class="al-note al-calm">{{ frost_state }}</div>{% endif %}
   {% if wx_line != "" %}<div class="al-sm">{{ wx_line }}</div>{% endif %}
   {% if sun_line != "" %}<div class="al-sm">{{ sun_line }}</div>{% endif %}
   {% if zone %}<div class="al-sm">Hardiness zone {{ zone }}</div>{% endif %}
   {% if season_txt != "" %}<div class="al-bar"><small>Growing season &middot; {{ sdays }} days</small><div class="al-track"><div class="al-fill" style="width:{{ pct }}%"></div></div><em>{{ season_txt }}</em></div>{% endif %}</div>
  <div class="al-col"><div class="al-hd">The Moon&rsquo;s Sign</div>
   <div class="al-moonrow">{{ moon_svg2 }}<div>{{ moon }}<i>in {{ msign }} &middot; {{ mel }}</i></div></div>
   {% unless r_leaf == 'A' %}<div class="al-row">Leafy crops<span class="al-dots"></span>{% if r_leaf == 'F' %}<span class="al-rt al-best">Best</span>{% else %}<span class="al-rt al-fair">Fair</span>{% endif %}</div>{% endunless %}
   {% unless r_root == 'A' %}<div class="al-row">Root crops<span class="al-dots"></span>{% if r_root == 'F' %}<span class="al-rt al-best">Best</span>{% else %}<span class="al-rt al-fair">Fair</span>{% endif %}</div>{% endunless %}
   {% unless r_cut == 'A' %}<div class="al-row">Prune &amp; cut<span class="al-dots"></span>{% if r_cut == 'F' %}<span class="al-rt al-best">Best</span>{% else %}<span class="al-rt al-fair">Fair</span>{% endif %}</div>{% endunless %}
   <div class="al-nm">Next full moon about {{ nf_s | date: "%b %-d" }}<br>Next new moon about {{ nw_s | date: "%b %-d" }}</div>
   <div class="al-foot">Traditional moon lore, not science</div></div>
  <div class="al-col"><div class="al-hd">Plant Now</div>
   {% if now_n == 0 %}<div class="al-item"><b>Relax, there is nothing to plant today.</b></div>{% endif %}
   {% assign c = 0 %}{% for e in ev.events %}{% if e.f == 1 %}{% assign anchor = ff %}{% else %}{% assign anchor = lf %}{% endif %}{% assign d = e.w | times: 7 | plus: anchor | minus: today %}{% if d < -14 %}{% assign d = d | plus: 365 %}{% endif %}{% if d >= -14 and d <= 6 and c < 5 %}{% assign c = c | plus: 1 %}<div class="al-item{% if c > 3 %} al-x{% endif %}"><b>{{ e.n }}</b><span>{% case e.a %}{% when 's' %}Start indoors{% when 't' %}Transplant{% when 'd' %}Direct sow{% else %}Plan{% endcase %}{% if e.dp %}, {{ e.dp }} in deep{% endif %}{% if e.sm and soil_i != nil %}{% if soil_i >= e.sm %} &middot; soil ok{% else %} &middot; soil too cold{% endif %}{% endif %}</span></div>{% endif %}{% endfor %}
   <div class="al-sub">Coming Up</div>
   {% assign c = 0 %}{% for e in ev.events %}{% if e.f == 1 %}{% assign anchor = ff %}{% else %}{% assign anchor = lf %}{% endif %}{% assign d = e.w | times: 7 | plus: anchor | minus: today %}{% if d < -14 %}{% assign d = d | plus: 365 %}{% endif %}{% if d >= 7 and d <= 60 and c < 5 %}{% assign c = c | plus: 1 %}{% assign eday = d | plus: today | minus: 1 | times: 86400 | plus: jan1 %}<div class="al-up{% if c > 3 %} al-x{% endif %}">{{ e.n }}{% if e.a == 's' %} (indoors){% elsif e.a == 't' %} (set out){% endif %}<span class="al-dots"></span>{{ eday | date: "%b %-d" }}</div>{% endif %}{% endfor %}
   <div class="al-sub" style="margin-top:auto">This Month</div><div class="al-chore">{{ chore }}</div></div>
 </div>
 <div class="al-wis"><small>Old World Wisdom</small>&ldquo;{{ proverb }}&rdquo;</div>
</div>
</div>
<div class="title_bar"><span class="title">Garden Almanac</span><span class="instance">{{ place }} · {{ ts | date: "%b %-d" }}</span></div>
